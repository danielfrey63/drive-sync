# Machine-specific overrides for config.ps1.
# Copy to config.local.ps1 (gitignored) and adjust what differs on this box.

$DriveSyncConfig.LocalRoot = "C:\Users\me\GoogleDrive"
$DriveSyncConfig.RemoteName = "gdrive"
# $DriveSyncConfig.MaxDeletes = 50
# $DriveSyncConfig.PollSeconds = 60
# the nightly start differs per machine: set it in $DriveSyncMachines (config.ps1),
# this file reaches every machine when the clone lies inside the synced corpus
